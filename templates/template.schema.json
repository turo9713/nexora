{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "agents", "skills", "permissions", "approval_required", "created_by", "status", "compatibility"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "name": {"type": "string", "minLength": 3, "maxLength": 100},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 10, "maxLength": 500},
    "agents": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}},
    "skills": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "filesystem", "network", "production"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM"]},
        "filesystem": {"enum": ["none", "workspace-read-only", "workspace-drafts"]},
        "network": {"enum": ["none", "search-only", "github-read-only"]},
        "production": {"const": false}
      }
    },
    "approval_required": {"type": "boolean"},
    "created_by": {"const": "Nexora"},
    "status": {"enum": ["ACTIVE", "DISABLED"]},
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["min_platform"],
      "properties": {"min_platform": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    }
  }
}
