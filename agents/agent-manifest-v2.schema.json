{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/agent-manifest-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "goal", "role", "skills", "knowledge", "tools", "permissions", "memory_scope", "approval_rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 2, "maxLength": 1000},
    "goal": {"type": "string", "minLength": 2, "maxLength": 1000},
    "role": {"type": "string", "minLength": 2, "maxLength": 120},
    "skills": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "knowledge": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "tools": {"type": "array", "items": {"enum": ["text_generation", "research", "code_analysis", "test_runner", "workspace_read", "workspace_write", "knowledge_read"]}, "maxItems": 32},
    "permissions": {"type": "array", "items": {"enum": ["workspace:read", "workspace:write", "drafts:write", "knowledge:read", "network:search"]}, "maxItems": 32},
    "memory_scope": {"enum": ["PERSONAL", "WORKSPACE", "AGENT"]},
    "approval_rules": {"type": "array", "items": {"type": "string"}, "maxItems": 32}
  }
}
