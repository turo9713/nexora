FROM python:3.14.7-slim-bookworm@sha256:23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52

ARG NEXORA_SERVICE=runtime
LABEL org.opencontainers.image.title="Nexora" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.description="Security-first AI agent platform" \
      org.opencontainers.image.service="$NEXORA_SERVICE"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace

RUN groupadd --gid 10001 nexora \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/nexora --shell /usr/sbin/nologin nexora

WORKDIR /workspace
COPY requirements-release.txt /tmp/requirements-release.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements-release.txt \
    && rm /tmp/requirements-release.txt
COPY --chown=10001:10001 . /workspace/nexora
RUN mkdir -p /workspace/nexora/runtime/state /workspace/nexora/runtime/status \
    && chown -R 10001:10001 /workspace/nexora/runtime

USER 10001:10001
