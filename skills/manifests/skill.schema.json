{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/schemas/skill-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "author", "category", "agent", "permissions", "risk", "tools", "security", "approval", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 100},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 5, "maxLength": 500},
    "author": {"type": "string", "const": "Nexora"},
    "category": {"type": "string", "enum": ["content", "research", "development", "analytics"]},
    "agent": {"type": "string", "enum": ["content", "research", "developer", "analytics", "qa"]},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "shell", "production"],
      "properties": {
        "filesystem": {
          "type": "object", "additionalProperties": false, "required": ["scope", "mode"],
          "properties": {
            "scope": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["drafts", "workspace", "data"]}},
            "mode": {"enum": ["read_only", "read_write"]}
          }
        },
        "network": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {"mode": {"enum": ["none", "search_only", "github_api_only"]}}
        },
        "shell": {
          "type": "object", "additionalProperties": false, "required": ["enabled"],
          "properties": {"enabled": {"const": false}}
        },
        "production": {
          "type": "object", "additionalProperties": false, "required": ["enabled"],
          "properties": {"enabled": {"const": false}}
        },
        "write": {"const": false}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["level"],
      "properties": {"level": {"enum": ["low", "medium"]}}
    },
    "tools": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["text_generation", "research", "repository_analysis", "reporting", "metrics_analysis", "github_read"]}
    },
    "security": {
      "type": "object", "additionalProperties": false, "required": ["sandbox"],
      "properties": {
        "sandbox": {
          "type": "object", "additionalProperties": false, "required": ["enabled"],
          "properties": {"enabled": {"const": true}}
        }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["required"],
      "properties": {"required": {"type": "boolean"}}
    },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["min_platform"],
      "properties": {"min_platform": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "status": {"enum": ["ACTIVE", "DISABLED"]}
  }
}
